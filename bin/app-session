#!/usr/bin/env python3
"""Manage workspace App session ownership through a JSON CLI."""
import argparse
import json
import sys

from _app_requests import prepare, result
from _app_sessions import claim, finish, record_capabilities, register, release, require_dispatcher, resume, show, transaction


def ownership(state, identifier):
    """Summarize who owns the workspace after an ownership change; `show` prints the full state."""
    summary = {'owner_epoch': state['owner_epoch'], 'dispatcher': state['dispatcher'],
               'session': state['sessions'].get(identifier)}
    if state.get('handoff'):
        summary['handoff'] = state['handoff']
    return summary


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    for command in ('register', 'show', 'capabilities'):
        subparser = commands.add_parser(command)
        subparser.add_argument('--session', required=True)
        if command == 'register':
            subparser.add_argument('--entry', choices=('app.codex', 'app.ccd'), required=True)
    preparing = commands.add_parser('prepare')
    preparing.add_argument('--session', required=True)
    preparing.add_argument('--operation', choices=('create', 'executor', 'read', 'wait', 'followup'), required=True)
    preparing.add_argument('--task', required=True)
    receiving = commands.add_parser('result')
    receiving.add_argument('--session', required=True)
    receiving.add_argument('--request', required=True)
    releasing = commands.add_parser('release')
    releasing.add_argument('--session', required=True)
    releasing.add_argument('--to', required=True)
    claiming = commands.add_parser('claim')
    claiming.add_argument('--session', required=True)
    claiming.add_argument('--entry', choices=('app.codex', 'app.ccd'), required=True)
    finishing = commands.add_parser('finish')
    finishing.add_argument('--session', required=True)
    finishing.add_argument('--task', required=True)
    resuming = commands.add_parser('resume')
    resuming.add_argument('--session', required=True)
    resuming.add_argument('--task', required=True)
    resuming.add_argument('--reason', required=True)
    for subparser in commands.choices.values():
        subparser.add_argument('--full', action='store_true', help='return the full workspace state after this operation')
    args = parser.parse_args()
    payload = json.load(sys.stdin) if args.command in ('prepare', 'result', 'capabilities') else None
    with transaction(readonly=args.command == 'show') as state:
        if args.full and args.command not in ('register', 'claim'):
            require_dispatcher(state, args.session)
        if args.command == 'register':
            output = ownership(register(state, args.session, args.entry), args.session)
        elif args.command == 'capabilities':
            output = record_capabilities(state, args.session, payload)
        elif args.command == 'prepare':
            output = prepare(state, args.session, args.operation, args.task, payload)
        elif args.command == 'result':
            output = result(state, args.session, args.request, payload)
        elif args.command == 'release':
            output = ownership(release(state, args.session, args.to), args.session)
        elif args.command == 'claim':
            output = ownership(claim(state, args.session, args.entry), args.session)
        elif args.command == 'finish':
            output = finish(state, args.session, args.task)
        elif args.command == 'resume':
            output = resume(state, args.session, args.task, args.reason)
        else:
            output = show(state, args.session)
        if args.full:
            output = state
    print(json.dumps(output, ensure_ascii=False))


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError) as error:
        print(f'app-session: {error}', file=sys.stderr)
        sys.exit(1)
