#!/usr/bin/env python3
"""Scan worktree, filenames and Git patches without printing matched content."""
import argparse
import os
from pathlib import Path
from _workspace import CONFIG
import re
import subprocess

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('root', nargs='?', default='.')
parser.add_argument('--git-dir', type=Path, help='scan history from an external Git directory')
args = parser.parse_args()
root = Path(args.root).resolve()
terms = CONFIG / 'scrub-terms.txt'
patterns = [r'sk-[A-Za-z0-9]{16,}', r'gh[pousr]_', 'ntn' + '_', 'secret' + '_',
            r'-----BEGIN (?:[A-Z]+ )*PRIVATE KEY-----', r'token\s*[=:]\s*\S{16,}']
if terms.exists():
    patterns.extend(line for line in terms.read_text().splitlines() if line.strip())
else:
    print('warning: private scrub terms missing; checking secret patterns only', flush=True)
checks = [re.compile(pattern, re.I) for pattern in patterns]
found = False


def matches(value):
    return any(pattern.search(value) for pattern in checks)


def scan(label, content):
    global found
    for number, line in enumerate(content.splitlines(), 1):
        if matches(line):
            print(f'{label}:{number}: sensitive pattern (redacted)')
            found = True


for directory, dirs, files in os.walk(root, followlinks=False):
    dirs[:] = sorted(name for name in dirs if name != '.git')
    for name in dirs + sorted(files):
        path = Path(directory) / name
        relative = str(path.relative_to(root))
        label = '[redacted filename]' if matches(relative) else relative
        if matches(relative):
            scan(label, relative)
        if path.is_symlink():
            scan(label, os.readlink(path))
        elif path.is_file():
            scan(label, path.read_bytes().decode('utf-8', errors='replace'))
if args.git_dir or (root / '.git').exists():
    git = ['git', '--git-dir', str(args.git_dir.expanduser().resolve())] if args.git_dir else ['git', '-C', str(root)]
    refs = subprocess.check_output(git + ['rev-list', '--all'], text=True)
    if refs.strip():
        history = subprocess.check_output(git + ['log', '--all', '-p', '--no-ext-diff',
                                           '--no-textconv', '--format=fuller'], text=True, errors='replace')
        # Patch line numbers identify the exact location without exposing a secret filename.
        scan('git-log.patch', history)
print('scrub-check: FAIL' if found else 'scrub-check: ok')
raise SystemExit(int(found))
