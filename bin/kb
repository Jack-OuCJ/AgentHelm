#!/usr/bin/env python3
"""Index, lint and distribute a research knowledge base; read project and task memory."""
import argparse
import os
import json
from pathlib import Path
import re

ROOT = Path(__file__).resolve().parent.parent
from _workspace import CONFIG, owned, write, register_skill
import _memory
BYTE_BUDGETS = {'AGENTS.md': 16384, 'rules/claude-global.md': 8192}
INDEX_LINES = 300
TASK_LINES = 300
DONE_BYTES = 200 * 1024 ** 2


def conclusions(lines):
    body = '\n'.join(lines)
    for heading in re.finditer(r'^#{1,2} (?:Conclusion|结论)([^\n]*)$', body, re.M):
        tail = body[heading.end():]
        section = re.split(r'(?m)^#{1,2} ', tail, maxsplit=1)[0]
        label = heading[1].strip().strip('()（）')
        date, _, topic = re.sub('，', ',', label).partition(',')
        tendency = re.search(r'\*\*(?:Tendency|倾向)(?:\*\*[:：]|[:：]\*\*)\s*(.+)', section, re.I)
        confidence = re.search(r'\*\*(?:Confidence|把握)(?:\*\*[:：]|[:：]\*\*)\s*(.+)', section, re.I)
        yield (body[:heading.start()].count('\n') + 1, date.strip(), topic.strip(),
               tendency[1].strip() if tendency else '', confidence[1].strip() if confidence else '')


def records():
    for path in sorted(ROOT.glob('experiments/*/README.md')):
        lines = path.read_text().splitlines()
        meta = {}
        for line in lines[1:]:
            match = re.fullmatch(r'- ([a-z_]+):\s*(.*)', line)
            if not match:
                break
            meta[match[1]] = match[2].strip()
        yield path, lines, meta


def documents(base, suffixes):
    """Navigation files below base; hidden, evidence and symbolic-link entries are skipped."""
    if base.is_symlink() or not base.is_dir():
        return []
    found = []
    for directory, folders, names in os.walk(base):
        folders[:] = sorted(name for name in folders if not name.startswith('.') and name != 'evidence'
                            and not os.path.islink(os.path.join(directory, name)))
        found += [Path(directory) / name for name in sorted(names) if name.endswith(suffixes)
                  and not name.startswith('.') and not os.path.islink(os.path.join(directory, name))]
    return found


def index(check):
    sections = {'Conclusions': [], 'Artifacts': [], 'Docs': [], 'Memory': [], 'Superseded': []}
    tasks = []
    for path, lines, meta in records():
        relative = path.relative_to(ROOT)
        ident = meta.get('id', path.parent.name)
        status = path.parent / 'STATUS'
        state = status.read_text().strip() if status.exists() else 'unstarted'
        tasks.append(f'- {ident} | {meta.get("question", "")} | {state}')
        if meta.get('superseded_by'):
            sections['Superseded'].append(f'- {ident} → {meta["superseded_by"]} | {relative}')
        else:
            for number, date, topic, tendency, confidence in conclusions(lines):
                sections['Conclusions'].append(f'- {ident} | {topic or meta.get("question", "")} | {tendency} | {confidence} | {date} | {relative}:{number}')
    for name in _memory.task_names():
        artifacts = ROOT / 'experiments' / name / 'artifacts'
        sections['Artifacts'] += [f'- [{name}/{p.relative_to(artifacts)}]({p.relative_to(ROOT)})'
                                  for p in documents(artifacts, ('.md', '.html'))]
    sections['Docs'] = [f'- [{p.relative_to(ROOT / "docs").with_suffix("")}]({p.relative_to(ROOT)})'
                        for p in documents(ROOT / 'docs', ('.md',))]
    memory, published, errors = _memory.publication()
    if errors:
        print('\n'.join(errors + ['index: invalid memory; nothing was published (fix the notes, then rerun bin/kb index)']))
        return 1
    sections['Memory'] = [f'- [{scope.title}]({scope.index})' for scope in published]
    outputs = {'INDEX.md': '# Index\n' + ''.join('\n## ' + k + '\n' + '\n'.join(v) + '\n' for k, v in sections.items()),
               'EXPERIMENTS.md': '# Experiments\n\n' + '\n'.join(tasks) + '\n', **memory}
    if check:
        stale = [name for name, value in outputs.items()
                 if ((ROOT / name).read_text() if (ROOT / name).is_file() else None) != value]
        print('\n'.join([f'stale: {name}' for name in stale] + ['index: stale' if stale else 'index: ok']))
        return int(bool(stale))
    for name, value in outputs.items():
        if value is None:
            owned(ROOT / name).unlink()
        else:
            write(ROOT / name, value)
    print('index: ok')
    return 0


def lint(brief=False):
    errors, warnings = [], []

    def budget(path, limit, byte=False):
        if path.exists():
            size = path.stat().st_size if byte else len(path.read_text().splitlines())
            if size > limit:
                warnings.append(f'{path.relative_to(ROOT)}:1: warning: budget {size} {"bytes" if byte else "lines"} > {limit}')
    items = list(records())
    known = {meta.get('id') for _, _, meta in items}
    seen = set()
    for path, lines, meta in items:
        reasons = [f'missing {key}' for key in ('id', 'question') if not meta.get(key)]
        if not lines or not lines[0].startswith('# '):
            reasons.append('missing title')
        ident = meta.get('id', '')
        if ident != path.parent.name or not re.fullmatch(r'[a-z0-9]+(?:-[a-z0-9]+)*', ident):
            reasons.append('id must match filename/directory in kebab-case')
        if ident in seen:
            reasons.append('duplicate id')
        seen.add(ident)
        if meta.get('superseded_by') and meta['superseded_by'] not in known:
            reasons.append('unknown superseded_by')
        budget(path, TASK_LINES)
        status = path.parent / 'STATUS'
        if status.exists() and status.read_text().split('|', 1)[0].strip() == 'done':
            size = 0
            for directory, _, files in os.walk(path.parent):
                for name in files:
                    p = Path(directory) / name
                    if not p.is_symlink():
                        size += p.stat().st_size
                    if size > DONE_BYTES:
                        break
                if size > DONE_BYTES:
                    break
            if size > DONE_BYTES:
                warnings.append(f'{path.relative_to(ROOT)}:1: warning: cleanup task directory exceeds 200 MB')
        errors.extend(f'{path.relative_to(ROOT)}:1: {reason}' for reason in reasons)
    for path in ROOT.glob('experiments/*/results.jsonl'):
        for number, line in enumerate(path.read_text().splitlines(), 1):
            try:
                row = json.loads(line)
                if not isinstance(row, dict) or not all(k in row for k in ('command', 'exit_code', 'artifact')):
                    raise ValueError('missing result fields')
            except ValueError:
                errors.append(f'{path.relative_to(ROOT)}:{number}: invalid result record')
    sources = [ROOT / 'AGENTS.md', ROOT / 'rules-extra.md']
    sources += sorted(ROOT.glob('rules/*.md')) + sorted(ROOT.glob('templates/*.md'))
    for path in sources:
        if not path.exists():
            continue
        for number, line in enumerate(path.read_text().splitlines(), 1):
            for code in re.findall(r'`([^`]+)`', line):
                if code.startswith(('bin/', 'templates/', 'rules/')):
                    target = code.split()[0]
                    if any(c in target for c in '<>*?['):
                        continue
                    if not (ROOT / target).exists():
                        errors.append(f'{path.relative_to(ROOT)}:{number}: missing path: {target}')
    for name, limit in BYTE_BUDGETS.items():
        budget(ROOT / name, limit, byte=True)
    budget(ROOT / 'INDEX.md', INDEX_LINES)
    issues = errors + warnings
    print('\n'.join(issues[:3] if brief else issues) if issues else 'lint: ok')
    if issues:
        print(f'lint: {len(errors)} error(s), {len(warnings)} warning(s)')
    return int(bool(errors))


def sync_agents():
    for filename in ('AGENTS.md', 'CLAUDE.md'):
        target = owned(ROOT / filename)
        content = (ROOT / 'templates' / ('workspace-' + filename)).read_text()
        if target.exists() and target.read_text() != content and not target.read_text().startswith('<!-- Generated by agenthelm workspace.'):
            raise SystemExit(f'sync-agents: preserve existing {target}; merge manually')
        write(target, content)
    for name in ('agenthelm-workflow', 'research-setup'):
        register_skill(name)
    print('sync-agents: workspace only')
    return 0


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    commands.add_parser('index').add_argument('--check', action='store_true')
    commands.add_parser('lint').add_argument('--brief', action='store_true')
    commands.add_parser('sync-agents')
    memory = commands.add_parser('memory', help='read-only project and task memory').add_subparsers(
        dest='action', required=True)
    memory.add_parser('context', help='project catalog, plus the task catalog with --task').add_argument('--task')
    memory.add_parser('read', help='one note with validity diagnostics').add_argument('note')
    memory.add_parser('check', help='project and every direct task, or one --task').add_argument('--task')
    memory.add_parser('fingerprint', help='dependencies JSON for workspace files').add_argument('files', nargs='+')
    args = parser.parse_args()
    if args.command == 'memory':
        raise SystemExit(_memory.main(args))
    raise SystemExit(index(args.check) if args.command == 'index' else lint(args.brief) if args.command == 'lint' else sync_agents())
