#!/usr/bin/env python3
"""Select local model roles and render commands from roles.toml."""
import argparse
import json
from pathlib import Path
import shlex
import shutil
import subprocess

from _toml import loads
from _models import command, generate, resolve_app, select, validate, write_ccd_agents

ROOT = Path(__file__).resolve().parent.parent
from _workspace import CONFIG as WORKSPACE_CONFIG
CONFIG = WORKSPACE_CONFIG / 'roles.toml'
MARKDOWN = CONFIG.with_name('models.md')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='action')
    sub.add_parser('get').add_argument('role')
    sub.add_parser('check')
    resolve = sub.add_parser('resolve')
    resolve.add_argument('role')
    resolve.add_argument('--entry', required=True, choices=('app.codex', 'app.ccd'))
    args = parser.parse_args()
    if not CONFIG.exists():
        if args.action == 'resolve':
            parser.error(f'missing configuration: {CONFIG}')
        print(f'models: copy {ROOT / "templates/roles.toml.example"} to {CONFIG} and customize it')
        return 0
    config = loads(CONFIG.read_text())
    if args.action == 'resolve':
        print(json.dumps(resolve_app(config, args.role, args.entry)))
        return 0
    validate(config)
    if args.action == 'get':
        active = select(config, config['roles'][args.role])
        if not active:
            parser.error('no enabled candidate for ' + args.role)
        print(active[0].replace(':', ' '))
    elif args.action == 'check':
        failed = False
        for provider, enabled in config['providers'].items():
            probe = config['commands'][provider].get('check')
            if not enabled or not probe:
                print(f'{provider}: skipped')
            elif not shutil.which(shlex.split(probe)[0]):
                print(f'{provider}: CLI missing; skipped')
            else:
                result = subprocess.run(probe, shell=True, timeout=60, stdin=subprocess.DEVNULL)
                print(f'{provider}: exit={result.returncode}')
                failed |= result.returncode != 0
        return int(failed)
    else:
        generate(config)
        write_ccd_agents(config)
        subprocess.run([str(ROOT / 'bin/kb'), 'sync-agents'], check=True)
        print(MARKDOWN.read_text(), end='')
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (ValueError, KeyError, IndexError, subprocess.TimeoutExpired) as error:
        raise SystemExit('models: ' + str(error))
