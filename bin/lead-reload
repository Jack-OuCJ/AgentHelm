#!/usr/bin/env python3
"""Print task handoff context without requiring a multiplexer.

Memory indexes come from bootstrap by restored role: a Lead sees project and task catalogs,
an Executor sees none. Note bodies are opened on demand with bin/kb memory read.
"""
import argparse
from pathlib import Path
from _workspace import task_directory, bootstrap, restored_session

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('task_dir')
parser.add_argument('source', nargs='?', default='startup')
parser.add_argument('count', nargs='?', type=int, default=0)
parser.add_argument('--entry', choices=('app.codex', 'app.ccd', 'cli.claude', 'cli.codex'))
parser.add_argument('--session')
args = parser.parse_args()
root = Path(__file__).resolve().parent.parent
task = task_directory(args.task_dir)
try:
    context = restored_session(args.session, args.entry, task)
except (ValueError, OSError) as error:
    parser.error(str(error))
if context:
    print(bootstrap(context['role'], task, entry=context['entry'], session=context['session']))
else:
    print(bootstrap('lead', task, entry=args.entry))
print(f'## Task context ({args.source}): {task.name}')
print('## STATUS')
status = task / 'STATUS'
print(status.read_text().strip() if status.exists() else '(none)')
print('## Latest task conclusions (INDEX.md)')
index = root / 'INDEX.md'
rows = [line for line in index.read_text().splitlines()
        if line.startswith('- ' + task.name + ' |') and f'experiments/{task.name}/README.md:' in line] if index.exists() else []
print('\n'.join(rows[-5:]) or '(none)')
if args.count >= 3:
    print(f'Compacted {args.count} times this session. Finish the current stage, save task memory and STATUS, then consider /clear.')
