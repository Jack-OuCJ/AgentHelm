#!/usr/bin/env python3
"""SessionStart hook: inject dispatcher or task context, without a watcher."""
import json
from pathlib import Path
import subprocess
import sys

root = Path(__file__).resolve().parent.parent
from _workspace import CONFIG, owned, bootstrap
event = json.load(sys.stdin)
cwd = Path(event['cwd']).resolve()
if cwd != root and root not in cwd.parents:
    raise SystemExit(0)
if cwd == root:
    role = CONFIG / 'role'
    if not role.exists() or role.read_text().strip() != 'dispatcher':
        raise SystemExit(0)
    print(bootstrap('dispatcher'))
    print('## TODO')
    todo = root / 'TODO.md'
    print(todo.read_text().strip() if todo.exists() else '(none)')
    done = []
    print('## Unfinished task STATUS')
    for path in sorted(root.glob('experiments/*/STATUS')):
        if path.read_text().split('|', 1)[0].strip() == 'done':
            done.append(path)
        else:
            print(path.parent.name + ': ' + path.read_text().strip())
    print('## Latest 3 completed task STATUS')
    for path in sorted(done, key=lambda p: p.stat().st_mtime, reverse=True)[:3]:
        print(path.parent.name + ': ' + path.read_text().strip())
    pending = sorted(root.glob('experiments/*/.feishu-pending'))
    if pending:
        print('## Feishu board sync pending (local STATUS is current)')
        for path in pending:
            print(path.parent.name + ': ' + path.read_text().strip())
else:
    while cwd != root and cwd.parent != root / 'experiments':
        cwd = cwd.parent
    if cwd == root:
        raise SystemExit(0)
    source = event.get('source', 'startup')
    counter = owned(cwd / '.compactions')
    count = 0
    if source == 'compact':
        sid = event.get('session_id', '')
        previous = counter.read_text().splitlines() if counter.exists() else []
        count = int(previous[1]) + 1 if len(previous) == 2 and previous[0] == sid else 1
        counter.write_text(f'{sid}\n{count}\n')
    elif counter.exists():
        counter.unlink()
    subprocess.run([str(root / 'bin/lead-reload'), str(cwd), source, str(count)], check=True)
