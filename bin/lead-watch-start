#!/usr/bin/env python3
"""SessionStart hook: inject dispatcher or task context, without a watcher."""
import json
from pathlib import Path
import subprocess
import sys

root = Path(__file__).resolve().parent.parent
home = Path.home()
event = json.load(sys.stdin)
cwd = Path(event['cwd']).resolve()
if cwd == root:
    role = home / '.config/research/role'
    if not role.exists() or role.read_text().strip() != 'dispatcher':
        raise SystemExit(0)
    try:
        subprocess.run([str(root / 'bin/rules-pull')], timeout=15, check=True)
    except (subprocess.TimeoutExpired, subprocess.CalledProcessError):
        print('rules sync failed or timed out; using local rules')
    status = home / '.local/state/rules-sync.status'
    if status.exists():
        print(status.read_text().strip())
    for command in (['kb', 'sync-agents'], ['board'], ['kb', 'index'], ['kb', 'lint', '--brief']):
        subprocess.run([str(root / 'bin' / command[0]), *command[1:]], check=False,
                       stdout=subprocess.DEVNULL if command == ['board'] else None)
    print('## TODO')
    todo = root / 'TODO.md'
    print(todo.read_text().strip() if todo.exists() else '(none)')
    done = []
    print('## Unfinished task STATUS')
    for path in sorted(root.glob('experiments/*/STATUS')):
        if path.read_text().split('|', 1)[0].strip() == 'done':
            done.append(path)
        else:
            print(path.parent.name + ': ' + path.read_text().strip())
    print('## Latest 3 completed task STATUS')
    for path in sorted(done, key=lambda p: p.stat().st_mtime, reverse=True)[:3]:
        print(path.parent.name + ': ' + path.read_text().strip())
elif cwd.parent == root / 'experiments':
    source = event.get('source', 'startup')
    counter = cwd / '.compactions'
    count = 0
    if source == 'compact':
        sid = event.get('session_id', '')
        previous = counter.read_text().splitlines() if counter.exists() else []
        count = int(previous[1]) + 1 if len(previous) == 2 and previous[0] == sid else 1
        counter.write_text(f'{sid}\n{count}\n')
    elif counter.exists():
        counter.unlink()
    subprocess.run([str(root / 'bin/lead-reload'), str(cwd), source, str(count)], check=True)
