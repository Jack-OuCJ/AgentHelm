#!/usr/bin/env python3
"""Print all task states and TODO; refresh BOARD.md."""
from pathlib import Path
root = Path(__file__).resolve().parent.parent
lines = ['# Board', '', '## Tasks', '']
for path in sorted(root.glob('experiments/*/STATUS')):
    lines.append(f'- {path.parent.name}: {path.read_text().strip()}')
lines += ['', '## TODO', '']
todo = root / 'TODO.md'
lines.append(todo.read_text().rstrip() if todo.exists() else '(none)')
content = '\n'.join(lines) + '\n'
(root / 'BOARD.md').write_text(content)
print(content, end='')
