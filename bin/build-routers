#!/usr/bin/env python3
"""Build skill routers from .agenthelm/config/routers.toml.

Configuration (all paths are local; relative paths resolve beside the config):
  library = "../../skills-library"
  output = "../../.agenthelm/routers"
  prefix = "route-"
  [routers.example]
  title = "Example skills"
  description = "When to read this router."
  skills = ["skill-name"]
  notes = ["Optional selection guidance."]
Every library directory containing SKILL.md must belong to exactly one router.
Python 3.9/3.10 support strings, booleans, integers, arrays and TOML tables.
"""
import argparse
import json
import os
from pathlib import Path
import re
import shutil
from urllib.parse import quote

from _toml import loads
from _workspace import ROOT, CONFIG, STATE, owned, write

MARKER = '<!-- Generated by bin/build-routers. -->'

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--agent', choices=('claude', 'codex', 'both'), help='向选定的项目 CLI 注册领域路由')
parser.add_argument('--replace-leaf-links', action='store_true', help='移除所选 CLI 中本安装器管理的逐技能链接')
parser.add_argument('--dry-run', action='store_true', help='预览生成、注册和链接替换，不写入')
args = parser.parse_args()
if args.replace_leaf_links and not args.agent:
    parser.error('--replace-leaf-links requires --agent')

config = CONFIG / 'routers.toml'
if not config.exists():
    print(__doc__)
    raise SystemExit(0)
data = loads(config.read_text())


def location(key):
    path = Path(data[key]).expanduser()
    return owned((config.parent / path).resolve() if not path.is_absolute() else path)


library, output = location('library'), location('output')
if output == library or library in output.parents:
    raise SystemExit('build-routers: router output must be outside the installed skill library')
prefix, routers = data['prefix'], data['routers']
known = {p.parent.name: p for p in library.glob('*/SKILL.md')}
seen = {}
for name, router in routers.items():
    if not re.fullmatch(r'[a-z0-9]+(?:-[a-z0-9]+)*', prefix + name):
        raise SystemExit('Invalid router name: ' + prefix + name)
    if len(router['description']) > 1536:
        raise SystemExit('Router description exceeds 1536 characters: ' + name)
    for skill in router['skills']:
        seen.setdefault(skill, []).append(name)
missing = sorted(known.keys() - seen.keys())
unknown = sorted(seen.keys() - known.keys())
duplicates = {skill: names for skill, names in seen.items() if len(names) != 1}
if missing or unknown or duplicates:
    raise SystemExit(f'missing={missing} unknown={unknown} duplicates={duplicates}')


def description(path):
    content = path.read_text()
    front = content.split('---', 2)[1]
    match = re.search(r'(?m)^description:\s*([^\n]*)(?:\n((?:[ \t]+[^\n]*\n?)*))', front)
    if not match:
        raise ValueError('Missing description: ' + str(path))
    value = match[1].strip()
    if value.startswith(('>', '|')) or not value:
        value = ' '.join(match[2].split())
    elif value.startswith('"'):
        value = json.loads(value)
    elif value.startswith("'"):
        value = value[1:-1].replace("''", "'")
    else:
        value += ' ' + ' '.join(match[2].split())
    return value.strip().replace('|', '\\|')[:300]


def relative_link(path, directory, label=None):
    relative = Path(os.path.relpath(path, directory)).as_posix()
    return f'[{label or relative}]({quote(relative, safe="/")})'


summaries = {skill: description(path) for skill, path in known.items()}
current = {prefix + name for name in routers}
for name in current:
    target = owned(output / name)
    if target.exists() and not target.is_dir():
        raise SystemExit('build-routers: preserve existing output: ' + str(target))
    path = owned(target / 'SKILL.md')
    if path.exists() and MARKER not in path.read_text().splitlines():
        raise SystemExit(f'build-routers: refusing to replace manual skill: {path}')
obsolete = [owned(path.parent) for path in output.glob('*/SKILL.md')
            if path.parent.name not in current and not path.parent.is_symlink()
            and MARKER in path.read_text().splitlines()]
folders = {None: (), 'claude': ('.claude/skills',), 'codex': ('.agents/skills',),
           'both': ('.agents/skills', '.claude/skills')}[args.agent]
registrations, removals = [], []
for name in sorted(current):
    target = owned(output / name)
    for folder in folders:
        link = owned(ROOT / folder / name)
        if (link.exists() or link.is_symlink()) and not (link.is_symlink() and link.resolve() == target.resolve()):
            raise SystemExit('build-routers: preserve existing skill entry: ' + str(link))
        registrations.append((link, target))
if args.replace_leaf_links:
    manifest = owned(STATE / 'skills-library.json')
    records = json.loads(manifest.read_text())['skills'] if manifest.exists() else {}
    if library.resolve() != (ROOT / 'skills-library').resolve() or known.keys() - records.keys():
        raise SystemExit('build-routers: leaf replacement requires installer-managed skills-library and manifest')
    for name in sorted(known):
        target = owned(library / name)
        for folder in folders:
            link = owned(ROOT / folder / name)
            if not (link.exists() or link.is_symlink()):
                continue
            if not link.is_symlink() or link.resolve() != target.resolve():
                raise SystemExit('build-routers: preserve existing leaf entry: ' + str(link))
            removals.append(link)
for target in obsolete:
    for folder in ('.agents/skills', '.claude/skills'):
        link = owned(ROOT / folder / target.name)
        if link.is_symlink() and link.resolve() == target.resolve():
            removals.append(link)
# Validate every output before generating files or replacing project links.
catalog = owned(library / 'CATALOG.md')
if catalog.exists() and not catalog.is_file():
    raise SystemExit('build-routers: catalog is not a file: ' + str(catalog))
print(f'routers: {len(current)}, project registrations: {len(registrations)}, leaf/stale links removed: {len(removals)}')
if args.dry_run:
    for name, router in routers.items():
        print(f'{prefix + name}: {router["title"]} ({len(router["skills"])} skills)')
    print('build-routers: preview only; no files changed')
    raise SystemExit(0)
for name, router in routers.items():
    name = prefix + name
    target = owned(output / name)
    lines = ['---', 'name: ' + name, 'description: ' + json.dumps(router['description']),
             '---', '', MARKER, '', '# ' + router['title'], '',
             '按下表用途选择最匹配的技能，先读取其完整 SKILL.md，再按需读取 references。',
             '实际使用时再安装该技能所需依赖；沿用用户既有工具偏好和授权边界。',
             '相对路径以本 SKILL.md 的真实所在目录为基准（先解析符号链接），不以终端启动目录为准。',
             '领域目录：' + relative_link(library / 'CATALOG.md', target), '']
    lines.extend('- ' + note for note in router.get('notes', []))
    lines.extend(['', '| Skill | Use | Instructions |', '|---|---|---|'])
    lines.extend(f'| {skill} | {summaries[skill]} | {relative_link(known[skill], target)} |' for skill in router['skills'])
    target.mkdir(parents=True, exist_ok=True)
    write(target / 'SKILL.md', '\n'.join(lines) + '\n')
    print(f'{name}: {len(router["skills"])} skills')
lines = ['# 领域技能目录', '', '相对路径以本 CATALOG.md 所在目录为基准。', '', '## 领域路由', '']
lines.extend(f'- {relative_link(output / (prefix + name) / "SKILL.md", library, router["title"])}：{len(router["skills"])} 个技能'
             for name, router in routers.items())
lines.extend(['', '## 技能索引', ''])
lines.extend(f'- {skill} | {prefix + seen[skill][0]} | {summaries[skill]} | {relative_link(known[skill], library)}' for skill in sorted(known))
write(catalog, '\n'.join(lines) + '\n')
for link, target in registrations:
    if not link.is_symlink():
        link.parent.mkdir(parents=True, exist_ok=True)
        link.symlink_to(os.path.relpath(target, link.parent), target_is_directory=True)
for link in removals:
    link.unlink()
for target in obsolete:
    shutil.rmtree(target)
print('build-routers: ok')
