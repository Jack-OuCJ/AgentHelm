#!/usr/bin/env python3
"""Build skill routers from .agenthelm/config/routers.toml.

Configuration (all paths are local; relative paths resolve beside the config):
  library = "/path/to/library"
  output = "/path/to/agent/skills"
  prefix = "route-"
  [routers.example]
  title = "Example skills"
  description = "When to read this router."
  skills = ["skill-name"]
  notes = ["Optional selection guidance."]
Every library directory containing SKILL.md must belong to exactly one router.
Python 3.9/3.10 support strings, booleans, integers, arrays and TOML tables.
"""
import json
from pathlib import Path
import re
import shutil

from _toml import loads
from _workspace import CONFIG, owned, write

MARKER = '<!-- Generated by bin/build-routers. -->'

config = CONFIG / 'routers.toml'
if not config.exists():
    print(__doc__)
    raise SystemExit(0)
data = loads(config.read_text())


def location(key):
    path = Path(data[key]).expanduser()
    return owned((config.parent / path).resolve() if not path.is_absolute() else path)


library, output = location('library'), location('output')
prefix, routers = data['prefix'], data['routers']
known = {p.parent.name: p for p in library.glob('*/SKILL.md')}
seen = {}
for name, router in routers.items():
    if not re.fullmatch(r'[a-z0-9]+(?:-[a-z0-9]+)*', prefix + name):
        raise SystemExit('Invalid router name: ' + prefix + name)
    if len(router['description']) > 1536:
        raise SystemExit('Router description exceeds 1536 characters: ' + name)
    for skill in router['skills']:
        seen.setdefault(skill, []).append(name)
missing = sorted(known.keys() - seen.keys())
unknown = sorted(seen.keys() - known.keys())
duplicates = {skill: names for skill, names in seen.items() if len(names) != 1}
if missing or unknown or duplicates:
    raise SystemExit(f'missing={missing} unknown={unknown} duplicates={duplicates}')


def description(path):
    content = path.read_text()
    front = content.split('---', 2)[1]
    match = re.search(r'(?m)^description:\s*([^\n]*)(?:\n((?:[ \t]+[^\n]*\n?)*))', front)
    if not match:
        raise ValueError('Missing description: ' + str(path))
    value = match[1].strip()
    if value.startswith(('>', '|')) or not value:
        value = ' '.join(match[2].split())
    elif value.startswith('"'):
        value = json.loads(value)
    elif value.startswith("'"):
        value = value[1:-1].replace("''", "'")
    else:
        value += ' ' + ' '.join(match[2].split())
    return value.strip().replace('|', '\\|')[:300]


summaries = {skill: description(path) for skill, path in known.items()}
current = {prefix + name for name in routers}
for name in current:
    path = owned(output / name / 'SKILL.md')
    if path.exists() and MARKER not in path.read_text().splitlines():
        raise SystemExit(f'build-routers: refusing to replace manual skill: {path}')
for path in output.glob('*/SKILL.md'):
    if path.parent.name not in current and not path.parent.is_symlink() and MARKER in path.read_text().splitlines():
        shutil.rmtree(owned(path.parent))
for name, router in routers.items():
    name = prefix + name
    lines = ['---', 'name: ' + name, 'description: ' + json.dumps(router['description']),
             '---', '', MARKER, '', '# ' + router['title'], '',
             'Read the matching skill before starting; open individual references only as needed.',
             'Library catalog: ' + str(library / 'CATALOG.md'), '']
    lines.extend('- ' + note for note in router.get('notes', []))
    lines.extend(['', '| Skill | Use | Instructions |', '|---|---|---|'])
    lines.extend(f'| {skill} | {summaries[skill]} | {known[skill]} |' for skill in router['skills'])
    target = owned(output / name)
    target.mkdir(parents=True, exist_ok=True)
    write(target / 'SKILL.md', '\n'.join(lines) + '\n')
    print(f'{name}: {len(router["skills"])} skills')
lines = ['# Skill catalog', '']
lines.extend(f'- {skill} | {prefix + seen[skill][0]} | {summaries[skill]} | {known[skill]}' for skill in sorted(known))
write(library / 'CATALOG.md', '\n'.join(lines) + '\n')
print('build-routers: ok')
