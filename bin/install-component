#!/usr/bin/env python3
"""Inspect an existing component; workspace mode does not install global plugins."""
import argparse
import shutil
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('component', choices=('herdr', 'ponytail', 'caveman', 'claude-hud', 'skills-library'))
parser.add_argument('--agent', choices=('claude', 'codex', 'both'), default='both')
parser.add_argument('--dry-run', action='store_true')
args = parser.parse_args()
if args.component == 'herdr' and shutil.which('herdr'):
    print('herdr: reusing ' + shutil.which('herdr'))
else:
    parser.error('automatic component installation is disabled; request a specific project-local installation separately')
