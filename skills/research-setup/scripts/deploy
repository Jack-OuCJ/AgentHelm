#!/usr/bin/env python3
"""Configure this checkout only; never install into HOME or replace global rules."""
import argparse
from pathlib import Path
import subprocess
import sys

root = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(root / 'bin'))
from _workspace import CONFIG, write

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('directory')
parser.add_argument('--role', choices=('dispatcher', 'executor'))
parser.add_argument('--env', choices=('cli-herdr', 'cli-plain', 'app'))
parser.add_argument('--rules-remote')
args = parser.parse_args()
if Path(args.directory).expanduser().resolve() != root:
    parser.error('workspace mode configures only this checkout; clone at the intended destination first')
if args.rules_remote:
    parser.error('private remote overlay and automatic sync are disabled in workspace mode')
for name, selected, fallback in (('role', args.role, 'dispatcher'), ('env', args.env, 'cli-herdr')):
    path = CONFIG / name
    if selected is not None or not path.exists():
        write(path, (selected or fallback) + '\n')
if not (CONFIG / 'roles.toml').exists():
    write(CONFIG / 'roles.toml', (root / 'templates/roles.toml.example').read_text())
if not (CONFIG / 'local.md').exists():
    write(CONFIG / 'local.md', '# 本机工作区约定\n\n- macOS，时区 Asia/Shanghai。\n- 复用 PATH 中的 Herdr、Claude Code 和 Codex。模型、账号、代理与权限沿用现有配置。\n- 主会话和 Lead 使用 Claude；执行角色按 roles.toml 选择，默认模型由各 CLI 决定。\n- Lead 上限 4；大型测试、构建和浏览器串行运行。\n- 新增工具和依赖只装在本工作区；全局安装需另行授权。\n- 不配置外部通知、Notion、私有规则远端或 cron。\n')
for command in ([str(root / 'bin/install-rules')],
                [str(root / 'skills/research-setup/scripts/merge-hooks')],
                [str(root / 'bin/models')], [str(root / 'bin/board')],
                [str(root / 'bin/kb'), 'index'], [str(root / 'bin/kb'), 'lint']):
    subprocess.run(command, check=True)
print('deploy: ready (workspace configuration only; no agent launched)')
