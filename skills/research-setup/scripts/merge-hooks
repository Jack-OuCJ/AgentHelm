#!/usr/bin/env python3
"""Merge the SessionStart hook into project settings only."""
import json
from pathlib import Path
import shlex
import sys
root = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(root / 'bin'))
from _workspace import owned, write
settings = owned(root / '.claude/settings.json')
data = json.loads(settings.read_text()) if settings.exists() else {}
entries = data.setdefault('hooks', {}).setdefault('SessionStart', [])
command = shlex.quote(str(root / 'bin/lead-watch-start'))
if not any(hook.get('command') == command for entry in entries for hook in entry.get('hooks', [])):
    entries.append({'matcher': 'startup|resume|clear|compact', 'hooks': [
        {'type': 'command', 'command': command, 'timeout': 10}]})
write(settings, json.dumps(data, ensure_ascii=False, indent=2) + '\n')
print('merge-hooks: project settings only')
