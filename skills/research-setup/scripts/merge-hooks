#!/usr/bin/env python3
"""Merge the SessionStart hook into project settings only."""
import json
from pathlib import Path
import shlex
import sys
root = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(root / 'bin'))
from _workspace import owned, write
settings = owned(root / '.claude/settings.json')
data = json.loads(settings.read_text()) if settings.exists() else {}
entries = data.setdefault('hooks', {}).setdefault('SessionStart', [])
marker = '# agenthelm-session-start'
source = '''# agenthelm-session-start
import json, os, subprocess, sys
from pathlib import Path
event = json.load(sys.stdin)
start = Path(os.environ.get('CLAUDE_PROJECT_DIR') or event['cwd']).resolve()
for directory in (start, *start.parents):
    hook = directory / 'bin/lead-watch-start'
    if hook.is_file() and (directory / 'skills/agenthelm-workflow/SKILL.md').is_file():
        raise SystemExit(subprocess.run([str(hook)], input=json.dumps(event), text=True).returncode)
'''
command = 'python3 -c ' + shlex.quote(source)


def managed(entry, hook):
    if hook.get('type') != 'command':
        return False
    try:
        parts = shlex.split(hook.get('command', ''))
    except ValueError:
        return False
    if len(parts) == 3 and parts[:2] == ['python3', '-c'] and parts[2].startswith(marker + '\n'):
        return True
    # Recognize the exact signature emitted by the former absolute-path installer,
    # including entries left behind after moving the checkout.
    return (len(parts) == 1 and Path(parts[0]).is_absolute()
            and Path(parts[0]).parts[-2:] == ('bin', 'lead-watch-start')
            and entry.get('matcher') == 'startup|resume|clear|compact'
            and hook.get('timeout') == 10)


found = False
updated = []
for entry in entries:
    hooks, removed = [], False
    for hook in entry.get('hooks', []):
        if managed(entry, hook):
            if found:
                removed = True
                continue
            hook = dict(hook, command=command)
            found = True
        hooks.append(hook)
    if hooks or not removed:
        updated.append(dict(entry, hooks=hooks))
entries[:] = updated
if not found:
    entries.append({'matcher': 'startup|resume|clear|compact', 'hooks': [
        {'type': 'command', 'command': command, 'timeout': 10}]})
write(settings, json.dumps(data, ensure_ascii=False, indent=2) + '\n')
print('merge-hooks: project settings only')
