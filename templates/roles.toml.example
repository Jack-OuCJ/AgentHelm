# 工作区模型分配。default 沿用已有 CLI 模型设置，不修改账号、代理和权限。
[providers]
claude = true
codex = true

[commands.claude]
template = 'claude --model {model} --effort {effort} {research_flags}'
default_template = 'claude {research_flags}'
research_flags = ''
check = 'claude --version'

[commands.codex]
template = 'codex exec -m {model} -c model_reasoning_effort={effort} {research_flags}'
default_template = 'codex exec {research_flags}'
research_flags = ''
check = 'codex --version'

[roles.lead]
desc = "任务组长"
tier = "Strategist"
candidates = ["claude:default"]
mode = "first"
research = false

[roles.lead_important]
desc = "重要任务组长"
tier = "Strategist"
candidates = ["claude:default"]
mode = "first"
research = false

[roles.hard]
desc = "复杂执行"
tier = "Executor"
candidates = ["codex:default"]
mode = "first"
research = false

[roles.fact]
desc = "研究与执行"
tier = "Executor"
candidates = ["claude:default"]
mode = "first"
research = false

[roles.chore]
desc = "机械工作"
tier = "Helper"
candidates = ["claude:default"]
mode = "first"
research = false

[roles.writing]
desc = "写作"
tier = "Strategist"
candidates = ["claude:default"]
mode = "first"
research = false

[roles.visual]
desc = "视觉设计"
tier = "Strategist"
candidates = ["claude:default"]
mode = "first"
research = false

[roles.review]
desc = "审查能力映射，流程按用户规则"
tier = "Executor"
candidates = ["codex:default"]
mode = "first"
research = false

[roles.simplify]
desc = "代码精简"
tier = "Executor"
candidates = ["codex:default"]
mode = "first"
research = false

[roles.aesthetic]
desc = "视觉审查"
tier = "Executor"
candidates = ["claude:default"]
mode = "first"
research = false
